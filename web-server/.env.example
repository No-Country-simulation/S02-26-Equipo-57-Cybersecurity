# Configuración de O.D.I.N. (SASK)
PORT=3000

# API Key de Groq (Obtenla en console.groq.com)
GROQ_API_KEY=tu_api_key_aqui

# URL del motor de seguridad (Python Engine)
# Local: http://localhost:8000
# Producción: https://tu-engine-python.render.com o similar
SECURITY_ENGINE_URL=http://localhost:8000
