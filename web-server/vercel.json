{
  "version": 2,
  "name": "odin-cybersecurity",
  "builds": [
    {
      "src": "src/app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/app.js"
    },
    {
      "src": "/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/docs-static/(.*)",
      "dest": "/../docs/$1"
    },
    {
      "src": "/notes-static/(.*)",
      "dest": "/../teamNotes/$1"
    },
    {
      "src": "/(.*)",
      "dest": "src/app.js"
    }
  ]
}
